{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexora Desktop",
  "version": "0.30.10",
  "identifier": "com.nexora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexora Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "\u0027self\u0027",
        "img-src": "\u0027self\u0027 asset: data: blob: https://asset.localhost",
        "media-src": "\u0027self\u0027 asset: https://asset.localhost data: blob:",
        "connect-src": "\u0027self\u0027 ipc: http://ipc.localhost",
        "script-src": "\u0027self\u0027",
        "style-src": "\u0027self\u0027 \u0027unsafe-inline\u0027",
        "font-src": "\u0027self\u0027 data:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "$HOME/**",
          "$TEMP/**",
          "$APPDATA/**",
          "$LOCALAPPDATA/**",
          "$VIDEO/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "windows": {
      "wix": {
        "version": "0.30.10.1"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe", "binaries/nexora-engine"],
    "resources": ["resources/vmaf_models"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMjAwMUM0RjlGMEQ1QTkKUldTcDFmRDV4QUVnMjNkejRxWGlqeERvVkxOc1ArQ2NScmZyQzhoMkV2WS8xM1Yvc3FiT0lvejkK",
      "endpoints": [
        "https://github.com/ideiasestrondosas-ctrl/nexora-desktop/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
